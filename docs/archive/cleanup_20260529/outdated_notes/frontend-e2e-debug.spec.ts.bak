import { test } from '@playwright/test'
import { REPAIR_SCHEDULE, createMockRouteHandler } from '../fixtures/mock-api'

test('debug strategy B states', async ({ page }) => {
  await page.route(/\/(health|api\/v1\/)/, createMockRouteHandler(REPAIR_SCHEDULE))
  await page.goto('/')
  await page.waitForSelector('.el-header', { timeout: 10000 })
  await page.click('.el-menu-item:has-text("求解")')
  await page.waitForSelector('h2:has-text("求解")', { timeout: 10000 })
  await page.waitForTimeout(2000)

  // Select machine
  await page.click('.el-select__wrapper')
  await page.waitForSelector('.el-select-dropdown', { timeout: 5000 })
  await page.click('.el-select-dropdown__item:has-text("Main CNC Lathe (M-001)")')
  await page.waitForTimeout(2000)

  // Check what states are in the second select
  await page.locator('.el-select__wrapper').nth(1).click()
  await page.waitForTimeout(500)
  const stateItems = await page.evaluate(() => {
    return Array.from(document.querySelectorAll('.el-select-dropdown__item')).map(el => el.textContent?.trim())
  })
  console.log('state items:', stateItems)

  const dropdownCount = await page.evaluate(() => document.querySelectorAll('.el-select-dropdown').length)
  console.log('dropdown count:', dropdownCount)

  const wrapperHTML = await page.evaluate(() => {
    const w = document.querySelectorAll('.el-select__wrapper')[1]
    return w ? w.outerHTML.substring(0, 300) : 'no wrapper'
  })
  console.log('second wrapper:', wrapperHTML)

  await page.screenshot({ path: '/tmp/playwright-debug-b.png' })
})

# Database Configuration
# These defaults work for both docker-compose and local PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_USER=solver
DB_PASSWORD=solver123
DB_NAME=solver_db

# Optional local PostgreSQL process management.
# Set these when PostgreSQL data lives outside this project folder.
# POSTGRES_DATA_DIR=E:\Solver_Resource_project\postgres-data
# POSTGRES_BIN_DIR=C:\Program Files\PostgreSQL\15\bin

# Connection timeout in seconds (used by both app and scripts)
DB_CONNECT_TIMEOUT=10

# Full Database URL (auto-constructed if not set)
# Optional override. Usually you can keep these commented and use DB_* above.
# DATABASE_URL=postgresql+asyncpg://solver:solver123@localhost:5432/solver_db
# DATABASE_URL_SYNC=postgresql://solver:solver123@localhost:5432/solver_db

# pgAdmin (optional, for docker-compose --profile admin)
PGADMIN_EMAIL=admin@solver.local
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# CP-SAT Solver
SOLVER_MAX_TIME_SECONDS=30.0
# Maximum elapsed calendar range compiled for one solve.
SOLVER_CALENDAR_MAX_HORIZON_DAYS=366

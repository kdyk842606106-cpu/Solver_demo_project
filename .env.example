# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=solver
DB_PASSWORD=solver123
DB_NAME=solver_db

# Full Database URL (auto-constructed if not set)
# DATABASE_URL=postgresql+asyncpg://solver:solver123@localhost:5432/solver_db
# DATABASE_URL_SYNC=postgresql://solver:solver123@localhost:5432/solver_db

# pgAdmin (optional, for docker-compose --profile admin)
PGADMIN_EMAIL=admin@solver.local
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# CP-SAT Solver
SOLVER_MAX_TIME_SECONDS=30.0
